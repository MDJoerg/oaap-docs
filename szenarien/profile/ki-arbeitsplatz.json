{
  "profile": "oaap.tenant-profile/1",
  "id": "ki-arbeitsplatz",
  "version": "2.2.0",
  "title": "KI-Arbeitsplatz: Chat mit Hilfe, Werkzeugen, Modellen und Vorgängen",
  "description": "RFC-0104, Fassung 2.2 (ab Referenz 0.1.318 und ai-gateway 0.10.1; Instanznamen wählbar). Legt an: Mandant mit Gesicht und Adresse, die Apps help, mcp-gateway, ai-gateway, chat und vorgaenge aus dem Store (Instanzen mit wählbaren Namen, Vorschlag hilfe, werkzeuge, modelle, chat, vorgaenge; ihre Schlüssel auf dem Knoten heißen <kürzel>-hilfe usw., und unter diesen Schlüsseln kennen die Apps einander), und richtet sie über ihre Einrichtungstüren ein: Hilfe holt die Doku, KI-Gateway mit Bezugsquelle, Modellname 'standard' und einer Freigabe für den Chat (kein Schlüssel zwischen Chat und KI-Gateway), MCP-Gateway mit Sicht 'hilfe', Zugangsprofil für den Chat und dem Assistenten 'Hilfe' für den ganzen Mandanten. Hält zweimal für einen Menschen an: die erste Verwaltung und die Zugangsdaten der Bezugsquelle. Ein eigener Anmeldedienst ist nicht nötig. Voraussetzung: die fünf Apps stehen in einer Katalogquelle des Knotens, in Fassungen mit Einrichtungstür.",
  "params": {
    "label": {"kind": "label", "required": true, "label": "Kürzel des Mandanten"},
    "title": {"kind": "text", "required": true, "max": 60, "label": "Name des Mandanten"},
    "color": {"kind": "color", "default": null, "label": "Hauptfarbe"},
    "supplier_url": {"kind": "text", "required": true, "max": 200,
                     "default": "https://api.anthropic.com/v1",
                     "label": "Adresse der Bezugsquelle bis /v1"},
    "supplier_light": {"kind": "text", "required": true, "max": 6, "default": "yellow",
                       "label": "Ampel der Bezugsquelle (green für ein lokales Modell, yellow für einen Anbieter wie Anthropic); zugleich die Ampel neuer Gespräche"},
    "model": {"kind": "text", "required": true, "max": 100, "default": "claude-sonnet-5-5",
              "label": "Modell der Bezugsquelle hinter dem Modellnamen 'standard'"},
    "with_realm": {"kind": "bool", "default": false,
                   "label": "Mit eigenem Anmeldedienst (Realm im Keycloak 'auth'; für den Chat nicht nötig)"}
,
    "name_help": {"kind": "word", "required": true, "default": "hilfe", "distinct": "instanz",
               "label": "Instanzname der Hilfe (App help)"},
    "name_tools": {"kind": "word", "required": true, "default": "werkzeuge", "distinct": "instanz",
               "label": "Instanzname der Werkzeuge (App mcp-gateway)"},
    "name_models": {"kind": "word", "required": true, "default": "modelle", "distinct": "instanz",
               "label": "Instanzname der Modelle (App ai-gateway)"},
    "name_chat": {"kind": "word", "required": true, "default": "chat", "distinct": "instanz",
               "label": "Instanzname des Chats (App chat)"},
    "name_cases": {"kind": "word", "required": true, "default": "vorgaenge", "distinct": "instanz",
               "label": "Instanzname der Vorgänge (App vorgaenge)"}
  },
  "steps": [
    {"id": "tenant", "type": "tenant.create", "label": "{label}", "title": "{title}"},
    {"id": "face", "type": "tenant.face", "title": "{title}", "color_primary": "{color}"},
    {"id": "address", "type": "address.ensure"},
    {"id": "address-wait", "type": "address.wait", "timeout": 180, "when": "with_realm"},
    {"id": "realm", "type": "idp.provision", "connector": "auth",
     "idp_label": "Mit dem Firmenkonto anmelden", "when": "with_realm"},
    {"id": "verwaltergruppe", "type": "idp.admin_group", "when": "with_realm"},
    {"id": "policy", "type": "tenant.policy", "first_login": "role", "default_role": "user",
     "self_registration": "off"},

    {"id": "hilfe", "type": "app.install", "app": "help", "name": "{name_help}"},
    {"id": "werkzeuge", "type": "app.install", "app": "mcp-gateway", "name": "{name_tools}"},
    {"id": "modelle", "type": "app.install", "app": "ai-gateway", "name": "{name_models}"},
    {"id": "chat", "type": "app.install", "app": "chat", "name": "{name_chat}"},
    {"id": "vorgaenge", "type": "app.install", "app": "vorgaenge", "name": "{name_cases}"},
    {"id": "tresor", "type": "app.config", "name": "{name_models}", "key": "AIGW_MASTER_KEY",
     "generate": true},
    {"id": "gespraechsampel", "type": "app.config", "name": "{name_chat}",
     "key": "CHAT_DEFAULT_LIGHT", "value": "{supplier_light}"},

    {"id": "docs-origin", "type": "destination.ensure", "name": "docs-origin",
     "instance": "{name_help}", "target": "https://codeload.github.com/MDJoerg/oaap-docs",
     "auth": "none"},
    {"id": "hilfe-holen", "type": "app.setup", "name": "{name_help}",
     "items": [{"kind": "fetch", "id": "docs"}]},

    {"id": "bezugsquelle", "type": "app.setup", "name": "{name_models}",
     "items": [{"kind": "supplier", "id": "anbieter", "url": "{supplier_url}",
                "light": "{supplier_light}"}]},
    {"id": "erster-verwalter", "type": "manual", "done_when": "role.tenant_admin",
     "text": "Ersten Verwalter anlegen: mit Realm dort eine Person anlegen und in die Gruppe 'oaap-verwalter' stecken, sie meldet sich einmal am Mandantenort an; ohne Realm im Portal unter Benutzer ein Konto im Mandanten anlegen. Dann im Portal die Rolle tenant_admin vergeben (danach neu anmelden) und 'Weiter prüfen'."},
    {"id": "zugangsdaten", "type": "manual", "done_when": "setup.ready",
     "instance": "{name_models}", "kind": "supplier", "item": "anbieter",
     "text": "Die Verwaltung trägt im KI-Gateway '{name_models}', Reiter Bezugsquellen, bei 'anbieter' die Zugangsdaten ein (z. B. den API-Schlüssel des Anbieters) und drückt 'testen'. Der Aufbau geht weiter, sobald das Gateway die Bezugsquelle erreicht ('Weiter prüfen')."},
    {"id": "modellname", "type": "app.setup", "name": "{name_models}",
     "items": [{"kind": "alias", "id": "standard", "supplier": "anbieter", "model": "{model}"},
               {"kind": "client", "id": "{label}-{name_chat}", "aliases": ["standard"],
                "ceiling": "yellow", "personal_data": false,
                "tenant": "{label}"}]},

    {"id": "werkzeuge-einrichten", "type": "app.setup", "name": "{name_tools}",
     "items": [{"kind": "refresh", "id": "{label}-{name_help}"},
               {"kind": "server_light", "id": "{label}-{name_help}", "light": "green"},
               {"kind": "view", "id": "hilfe", "accesses": ["platform"],
                "tools": {"server": "{label}-{name_help}", "effect": "read"}},
               {"kind": "profile", "id": "{label}-{name_chat}", "group": "@{label}-{name_chat}",
                "views": ["hilfe"], "ceiling": "yellow"},
               {"kind": "assistant", "id": "hilfe", "title": "Hilfe", "view": "hilfe",
                "gateway": "{label}-{name_tools}", "model": "standard",
                "greeting": "Ich beantworte Fragen zur Plattform aus ihrer Dokumentation und nenne die Seite, aus der die Antwort stammt.",
                "visibility": "tenant"}]},
    {"id": "sicherung", "type": "backup.check"}
  ]
}
